# ---------------------------------------------------------------
# Required — get these from your provider dashboards
# ---------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ---------------------------------------------------------------
# Optional — defaults shown below
# ---------------------------------------------------------------

# Whisper model size: tiny | base | small | medium | large | large-v2 | large-v3
# Larger models are more accurate but slower and use more RAM.
WHISPER_MODEL=base

# OpenAI model name
LLM_MODEL=gpt-4o-mini

# ElevenLabs voice ID
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Audio capture settings
# AUDIO_SAMPLE_RATE must match the rate expected by your STT model (Whisper uses 16000)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024

# TTS output sample rate — must match ElevenLabsTTS output_format
# Changing this requires updating the output_format passed to ElevenLabsTTS in main.py.
# Supported values depend on ElevenLabs plan: 24000 (default), 44100
TTS_SAMPLE_RATE=24000
